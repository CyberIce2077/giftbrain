-# locals: (recipient:, products:)
= render "recipients/tr", recipient:, show_text: "Back", show_turbo: false

.hint.center-element
  Ship to #{link_to(countries_for_select.invert[recipient.ship_to_country], [:edit, recipient])}

- if products.empty?
  .hint.center-element No products found in Aliexpress for this idea
- else
  .product-wrapper
    = render partial: "/affiliate/aliexpress/products/table", locals: { products: }
  = paginate products
