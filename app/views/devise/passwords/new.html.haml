.box-container.center-element
  .panel
    %h2 Forgot your password?
    = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }, data: { turbo: false }) do |f|
      = render "devise/shared/error_messages", resource: resource
      .field
        = f.label :email
        %br/
        = f.email_field :email, autofocus: true, autocomplete: "email", class: "is-input"
      .actions
        = f.submit "Send me reset password instructions", class: "is-button"
      = turnstile_widget
    = render "devise/shared/links"
