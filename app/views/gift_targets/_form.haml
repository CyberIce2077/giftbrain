.box-container
  .box
    - if gift_target.errors.any?
      %h3= "#{pluralize(gift_target.errors.count, 'error')} prohibited this gift target from being saved:"
      %ul
        - gift_target.errors.full_messages.each do |message|
          %li= message
      %hr/

    %h1 Describe the target
    %hr/

    = form_with model: gift_target, data: { turbo: false } do |f|
      = f.label :name, "Name"
      = f.text_field :name
      %hr/

      %h4 Description
      = f.text_area :description, rows: 5, style: "width: 100%;"
      %hr/

      = f.submit "Save", class: 'is-button'
      - if gift_target.persisted?
        = link_to('Cancel', [gift_target])
