.box-container
  .box
    .box.center-elements
      = link_to('Show', [gift_target], class: 'is-button')
      = link_to('Edit', [:edit, gift_target], class: 'is-button')
      = form_tag([gift_target], method: :delete, data: { turbo: false }, onsubmit: "return confirm('Are you sure you want to delete this gift_target?');") do
        = submit_tag('Destroy', class: 'is-button')
    %h1= gift_target.name
    = gift_target.status
    %p= gift_target.description
