-# locals(date:, recipients:, teams:)
.box-panel
  .box-container
    .detailed-box-title-row
      .detailed-box-title= "#{I18n.t('date.abbr_month_names')[date.month]} #{date.year}"
      = link_to("<", url_for(date: date.last_month), class: "detailed-box-back-button")
      = link_to("Today", url_for(date: Time.zone.now.to_date), class: "detailed-box-back-button")
      = link_to(">", url_for(date: date.next_month), class: "detailed-box-back-button")
  = render '/recipients/table', recipients:, teams:
  = paginate recipients
