%div{ data: { controller: "navbar" } }
  .box-container.center-elements
    = link_to('/') do
      = image_tag("logo.jpeg", alt: "Cover Media", class: "nav-logo")
    %h1= link_to('GiftBrain', '/')
    %button{ data: { action: "click->navbar#toggle" }, class: "is-button hamburger-toggle-menu" }
      ☰ Menu
  .nav-menu.center-elements.nav-menu-hidden{ data: { navbar_target: "menu" } }
    - if policy(:home).calendar?
      = link_to('Calendar', '/calendar', class: 'is-button')
    - if policy(Recipient).new?
      = link_to('New Chat', [:new, :recipient], class: 'is-button')
    - if policy(:home).about?
      = link_to('About', '/about', class: 'is-button')
    - if current_user
      = form_tag(destroy_user_session_path, method: :delete, data: { turbo: false }) do
        = submit_tag('Sign out', class: 'is-button')
    - else
      = link_to('Log in', new_user_session_path, class: 'is-button')
