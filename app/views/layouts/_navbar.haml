-# locals: (toogle_menu: (@toogle_menu && request.fullpath == "/"))
%div{ data: { controller: "navbar", toogle_menu: @toogle_menu } }
  .box-container.center-elements
    = link_to('/', data: { turbo: false }) do
      = image_tag("logo.jpeg", alt: "Cover Media", class: "nav-logo")
    .box-title= link_to('GiftBrain', '/', data: { turbo: false })
    %button{ data: { action: "click->navbar#toggle" }, class: "is-button is-hamburger-toggle-menu-button" }
      ☰ Menu
  .nav-menu.center-elements{ data: { navbar_target: "menu" } }
    - if policy(Recipient).new?
      = link_to('New Chat', [:new, :recipient], class: 'is-button')
    - if policy(:home).calendar?
      = link_to('Calendar', '/calendar', class: 'is-button')
    - if policy(Recipient).index?
      = link_to('Home', '/', data: { turbo: false }, class: 'is-button')
    - if policy(:home).about?
      = link_to('About', '/about', class: 'is-button')
    - if current_user
      = button_to("Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: 'is-button')
    - else
      = link_to('Log in', new_user_session_path, data: { turbo: false }, class: 'is-button')
      %br/
