%button{ data: { controller: "sidebar", action: "click->sidebar#invisible" }, class: "sidebar-close-button" }
  x

.box-options
  .sidebar-scrollable
    .sidebar-container
      - if policy(Recipient).index?
        = link_to("Home", "/", data: { turbo: false }, class: "is-button #{'active' if current_page?('/')}")
      - if policy(Recipient).new?
        = link_to("New Chat", [:new, :recipient], class: "is-button #{'active' if current_page?(new_recipient_path)}")
      - if policy(:home).calendar?
        = link_to("Calendar", "/calendar", class: "is-button #{'active' if current_page?('/calendar')}")
      - if policy(Team).index?
        = link_to("Teams", [:teams], class: "is-button #{'active' if current_page?(teams_path)}")
      - if policy(:home).about?
        = link_to("About", "/about", class: "is-button #{'active' if current_page?('/about')}")
  .sidebar-bottom
    %hr/
    .sidebar-container
      - if current_user
        = button_to("Sign out", destroy_user_session_path, method: :delete, data: { turbo: false }, class: "is-button")
      - else
        = link_to("Log in", new_user_session_path, data: { turbo: false }, class: "is-button")
        = link_to("Sign up", new_user_registration_path, data: { turbo: false }, class: "is-button")
