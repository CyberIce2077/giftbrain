.box-container.center-element
  .box-title= "Hello, #{@user.email} !"
  .box-description
    %p= "This is a reminder that #{event_due_date(@reminder)}".humanize
    %p= "You can check the event for '#{@recipient.name}' #{link_to("here", [@recipient])}"
    %p= "Event date: #{@recipient.event_date}"
  .hint
    = link_to("GiftBrain", root_url)
    |
    = link_to("Unsubscribe", users_unsubscribe_index_url(ut: @user.unsubscribe_token))
