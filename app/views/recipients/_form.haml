.box-container
  .box
    - if recipient.errors.any?
      %h3= "#{pluralize(recipient.errors.count, 'error')} prohibited this gift target from being saved:"
      %ul
        - recipient.errors.full_messages.each do |message|
          %li= message
      %hr/

    %h1 Describe the target
    %hr/

    = form_with model: recipient, data: { turbo: recipient.persisted? ? true : false } do |f|
      = f.label :name, "Name"
      = f.text_field :name
      %hr/

      %h4 Description
      = f.text_area :description, rows: 5, style: "width: 100%;"
      %hr/

      = f.submit "Save", class: 'is-button'
      - if recipient.persisted?
        = link_to('Cancel', [recipient])
