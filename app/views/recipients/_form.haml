-# locals: (recipient:, back_url: request.referer || root_path)
.panel
  .box-container
    .box-title Describe the person
    %hr/
    = form_with model: recipient, data: { turbo: false } do |f|
      .center-elements
        = f.label :name, "Name"
        = f.text_field :name, maxlength: 50, class: "is-input"
      %hr/

      = f.label :event_date, "Event Date"
      = f.date_field :event_date, class: "is-input"
      %hr/

      = f.label :description, "Description"
      = f.text_area :description, maxlength: 300, class: "is-textarea", placeholder: "Tell us more about this person - their interests, background or anything that will help generate better ideas"
      %hr/

      = f.check_box :repeat_annually
      = f.label :repeat_annually, "Repeat every year"
      .hint This option is perfect for birthdays, anniversaries and other yearly traditions
      %hr/

      = f.label :ship_to_country, "Ship to Country"
      = f.select :ship_to_country, options_for_select(countries_for_select, recipient.new_record? ? current_user_country : recipient.ship_to_country), class: "is-input"
      .hint Select the country where gifts will be shipped
      %hr/

      = f.label :reminders, "Reminders"
      %br/
      = f.fields_for :reminders, recipient.reminders.sort_by { |r| Reminder.kinds[r.kind] } do |rf|
        = rf.check_box :active
        = rf.hidden_field :kind
        = rf.label :active, rf.object.kind.humanize.capitalize
      .hint Choose when to receive reminder emails before the event
      %hr/

      = f.submit "Save", class: "is-button"
      = link_to("Cancel", back_url)
