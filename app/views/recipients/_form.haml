.box-container
  .box
    .box-title Describe the target
    %hr/
    = form_with model: recipient, data: { turbo: recipient.persisted? ? true : false } do |f|
      .center-elements
        = f.label :name, "Name"
        = f.text_field :name, maxlength: 50, class: "is-input"
      %hr/

      = f.label :event_date, "Event Date"
      = f.hidden_field :event_date, id: "event-date-input"
      %div{ data: { controller: "calendar" }, id: "calendar" }
      %hr/

      = f.label :description, "Description"
      = f.text_area :description, maxlength: 300, class: "is-textarea"
      %hr/

      = f.submit "Save", class: 'is-button'
      - if recipient.persisted?
        = link_to('Cancel', [recipient])
