-# locals: (recipient:, back_url: request.referer || root_path)
.box-container
  .box
    .recipient-name= recipient.name
    .recipient-stats
      Ideas count:
      = recipient.ideas_count
      |
      = link_to("Back", back_url, data: { turbo: false }, class: 'is-button')
    .box-description= recipient.description
  .progress-container{ data: { controller: "progress", progress_status_value: recipient.status, progress_duration_value: recipient.estimated_generation } }
    .progress-bar{ data: { progress_target: "bar" } }
  - if recipient.editable?
    .center-elements
      = link_to('Edit', [:edit, recipient], class: 'is-button', data: { turbo_stream: true })
      - if recipient.ideas_count < Idea::MAX_IDEA_COUNT
        = button_to('Generate new ideas', [:generate_ideas, recipient], method: :patch, class: 'is-button')
      = button_to("Delete", [recipient], method: :delete, data: { turbo: false, controller: "confirm", action: "click->confirm#click" }, class: 'is-button')
  - else
    .box-description
      .hint.center-element
        %p Generating ideas may take a moment
  - if recipient.ideas_count >= Idea::MAX_IDEA_COUNT
    .box-description
      .hint.center-element= "You have reached the maximum of #{Idea::MAX_IDEA_COUNT} ideas"
- if recipient.ideas_count > 0
  .box
    .hint.center-element
      You can now move and order the ideas
- elsif recipient.editable?
  .box
    .hint.center-element
      No ideas yet. Tap “Generate new ideas” to get started!
