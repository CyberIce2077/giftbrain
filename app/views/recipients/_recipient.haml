.box-container
  .box
    %h1= recipient.name
    %p= recipient.status
    %p= recipient.ideas.size
    %p= recipient.description
  - if recipient.draft_status? || recipient.failed_status? || recipient.success_status?
    .box.center-elements
      = link_to('Edit', [:edit, recipient], class: 'is-button', data: { turbo_stream: true })
      = button_to('Generate new ideas', [:generate_ideas, recipient], method: :patch, class: 'is-button')
      = button_to('Destroy', [recipient], method: :delete, data: { turbo: false }, onClick: "return confirm('Are you sure you want to delete this recipient?');", class: 'is-button')
