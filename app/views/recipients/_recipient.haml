.box-container
  .box
    .box.center-elements
      = link_to('Show', [recipient], class: 'is-button')
      = link_to('Edit', [:edit, recipient], class: 'is-button')
      = form_tag([recipient], method: :delete, data: { turbo: false }, onsubmit: "return confirm('Are you sure you want to delete this recipient?');") do
        = submit_tag('Destroy', class: 'is-button')
    %h1= recipient.name
    = recipient.status
    %p= recipient.description
