-# locals: (recipient:)
.ai-container
  #ai-glow{ data: { controller: "ai-glow" } }
  .box-options
    - if recipient.editable? && recipient.recipient_ideas_count < Idea::MAX_IDEA_COUNT
      = button_to("Generate new ideas", [:generate_ideas, recipient], method: :patch, class: "is-button")
    = progress_bar(recipient)
- if recipient.recipient_ideas_count > 0
  .hint.center-elements You can now move and order the ideas
- elsif recipient.editable?
  .hint.center-elements Click "Generate new ideas" to get started!
