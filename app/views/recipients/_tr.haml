= turbo_frame_tag(recipient) do
  .box-container
    .box
      .recipient-name= recipient.name
      .recipient-stats
        Ideas
        - if policy(recipient).show?
          |
          = link_to('Show', [recipient], class: 'is-button', data: { turbo: false })
        |
        Status:
        = recipient.status
      .box-description= recipient.description
    .progress-container{ data: { controller: "progress", progress_status_value: recipient.status, progress_duration_value: recipient.generation_duration } }
      .progress-bar{ data: { progress_target: "bar" } }
    %br/
