= turbo_frame_tag(recipient) do
  .box-container
    .box
      .recipient-name= recipient.name
      .recipient-stats
        Ideas
        - if policy(recipient).show?
          |
          = link_to('Show', [recipient], class: 'is-button', data: { turbo: false })
        |
        Status:
        = recipient.status
      .box-description= recipient.description
    %div{ data: { controller: "progress", progress_status_value: recipient.status }, style: "height: 6px;" }
    %br/
    %br/
