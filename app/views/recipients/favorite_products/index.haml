-# locals: (recipient:, favorite_products:)
= render "recipients/tr", recipient:, show_text: "Back"

.hint.center-element
  Ship to #{link_to(countries_for_select.invert[recipient.ship_to_country], [:edit, recipient])}

.product-wrapper
  = render partial: "recipients/favorite_products/favorite_product", collection: favorite_products, as: :favorite_product, locals: { recipient: }
= paginate favorite_products
