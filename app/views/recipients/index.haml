-# locals: (recipients:, teams:)
- if current_user
  - if @toogle_menu
    .hint.center-element
      Ready to find the perfect gift?
      %br/
      Start by clicking New Chat to add someone special or
      - if policy(Recipient).new?
        = link_to("click here", [:new, :recipient])
  - else
    = render "/recipients/table", recipients:, teams:
    = paginate recipients
- else
  .box-container
    .box-title Welcome to GiftBrain
    %p GiftBrain is your smart AI-powered assistant for finding the perfect gift
    %p Simply #{link_to("log in", new_user_session_path, data: { turbo: false })}, to get started
    %p Describe who you're buying for and GiftBrain will generate personalized ideas
    %p Want to decide as a group? You can create teams, invite others, and vote together for the best gift ideas
    %p We'll handle the rest!
    %p Want to learn more? #{link_to("Check out how it works", about_path)}
