.box-container
  .box.center-elements
    - if recipient.failed_status? || recipient.success_status?
      = link_to('Edit', [:edit, recipient], class: 'is-button')
      = form_tag([:generate_ideas, recipient], method: :patch) do
        = submit_tag('Generate new ideas', class: 'is-button')
  .box
    %h1= recipient.name
    = recipient.status
    %p= ideas.size
    %p= recipient.description

- if ideas.size > 0
  .hint.center-element
    You can now move and order the ideas

.gift-cards-wrapper{ data: { controller: "sortable", recipient_id: recipient.id } }
  = render partial: '/recipients/idea', collection: ideas, as: :idea, locals: { recipient: }
