-# locals: (team:, recipient:, back_url: request.referer || root_path)
.panel
  .box-container
    .box-title Convert to a Team
    %hr/
    = form_with model: [recipient, team], data: { turbo: false } do |f|
      .center-elements
        = f.label :name, "Name"
        = f.text_field :name, maxlength: 50, class: "is-input"
      %hr/

      = f.check_box :public_join
      = f.label :public_join, "Allow public joining"
      .hint This option allows anyone with the link to join the team
      %hr/

      = f.submit "Save", class: 'is-button'
      = link_to("Cancel", back_url)
