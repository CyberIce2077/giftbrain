-# locals: (team:, team_member:)
= turbo_frame_tag(team_member) do
  .box-container
    .detailed-box-title-row
      .detailed-box-title= team_member.user.email
    %hr/
    .box-options
      Status: #{team_member.status.humanize}
      - if team_member.user != team.recipient.creator && policy(team).edit?
        = button_to("Delete", [team_member], method: :delete, data: { turbo_stream: true, controller: "confirm", action: "click->confirm#click" }, class: 'is-button')
