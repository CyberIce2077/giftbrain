-# locals: (team:)
.box-container
  .detailed-box-title-row
    .detailed-box-title= team.name
    - if policy(team).show?
      = link_to('Show', [team], class: "detailed-box-back-button")
    - if policy(team).invitations?
      = link_to("Open invitation", [:invitations, team], class: "detailed-box-back-button")
