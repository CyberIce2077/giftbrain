-# locals: (team:)
= turbo_frame_tag(team, data: { controller: "recipient" }) do
  .recipient-container
    .box
      .recipient-name= team.name
      .recipient-stats
        Members count:
        = team.members_count
        - if policy(team).show?
          |
          = link_to('Show', [team], class: 'is-button', data: { action: "click->recipient#show", turbo: false })
        - if policy(team).invitations?
          = link_to("Open invitation", [:invitations, :teams, { invitation_token: team.invitation_token }], data: { turbo: false }, class: 'is-button')
