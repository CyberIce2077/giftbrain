-# locals: (team:, recipient: team.recipient, team_members:, copy_target: "#{root_url}teams/#{team.id}/invitations")
.box-panel.float-left
  .detailed-box-container
    .detailed-box-title-row
      .detailed-box-title= team.name
      = link_to("Back", [:teams], class: "detailed-box-back-button")
    %hr/
    .box-options
      - if policy(team).edit?
        = link_to('Edit', [:edit, recipient, team], class: 'is-button')
        = link_to("Add Member", [:new, team, :team_member], class: 'is-button')
        = button_to('Copy invitation URL', '#', type: 'button', class: 'is-button', data: { action: 'click->copy#copy', copy_target: })
      - if policy(team).destroy?
        = button_to("Delete", [team], method: :delete, data: { turbo: false, controller: "confirm", action: "click->confirm#click" }, class: 'is-button')

.box-panel.float-left
  - if team.team_members_count <= 1
    .hint.center-element
      This team has no members yet
      %br/
      Click #{link_to("Add Member", [:new, team, :team_member])} to invite someone
  = render partial: '/teams/team_member', collection: team_members, as: :team_member, locals: { team: }

:javascript
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('button[data-action="click->copy#copy"]').forEach(function(btn) {
    btn.addEventListener('click', function(event) {
        event.preventDefault()
        navigator.clipboard.writeText(btn.dataset.copyTarget);
      });
    });
  });
