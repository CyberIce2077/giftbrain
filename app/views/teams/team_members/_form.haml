-# locals: (team:, team_member:)
.panel
  .box-container
    .box-title Invite someone to your team
    %hr/
    = form_with model: [team, team_member], data: { turbo: false } do |f|
      .center-elements
        = f.label :email, "Email"
        = f.email_field :email, maxlength: 50, class: "is-input", placeholder: "example@domain.com"
      .hint
        %p Only registered users can be invited to the team
        - if team.public_join?
          %p You can copy the link and share it with anyone from #{link_to("here", [:copy_public_link, team])}
        - else
          %p You can enable public join and share the link with anyone from #{link_to("here", [:edit, team.recipient, team])}
      %hr/

      = f.submit "Send invite", class: 'is-button'
      = link_to("Cancel", [team])
